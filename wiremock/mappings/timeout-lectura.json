{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/core/transferencias",
    "basicAuthCredentials": { "username": "usuario-local", "password": "clave-falsa-solo-local" },
    "bodyPatterns": [ { "matchesXPath": "/TransferenciaRequest[Origen='990000001']" } ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/xml; charset=UTF-8" },
    "body": "<TransferenciaResponse><Codigo>00</Codigo><Referencia>CORE-{{randomValue length=6 type='NUMERIC'}}</Referencia><Mensaje>APROBADA</Mensaje></TransferenciaResponse>",
    "transformers": ["response-template"],
    "fixedDelayMilliseconds": 20000
  }
}
